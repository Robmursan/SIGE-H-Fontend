  "info": {
    "title": "SIGE-H API",
    "description": "Sistema Integral de Gestión de Enfermería Hospitalaria - API REST",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Estado de vida (liveness) del proceso API (CU-OPS-01)",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "description": "Identificador lógico del servicio API",
            "example": "sige-h-api"
          },
          "timestamp": {
            "type": "string",
            "description": "Marca temporal UTC de la verificación en formato ISO 8601",
            "example": "2026-11-10T22:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp"
        ]
      },
      "DatabaseHealthUpDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Estado de conectividad con PostgreSQL",
            "example": "up",
            "enum": [
              "up"
            ]
          },
          "schema": {
            "type": "string",
            "description": "Esquema configurado en PostgreSQL",
            "example": "sigeh"
          },
          "schemaVerified": {
            "type": "boolean",
            "description": "Indica si el esquema configurado fue verificado en information_schema.schemata",
            "example": true
          },
          "latencyMs": {
            "type": "number",
            "description": "Latencia de verificación SQL en milisegundos",
            "example": 2
          }
        },
        "required": [
          "status",
          "schema",
          "schemaVerified",
          "latencyMs"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Estado general de preparación (readiness) del servicio",
            "example": "ok",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "description": "Identificador lógico del servicio API",
            "example": "sige-h-api"
          },
          "database": {
            "description": "Diagnóstico de conectividad y esquema en PostgreSQL",
            "allOf": [
              {
                "$ref": "#/components/schemas/DatabaseHealthUpDto"
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "description": "Marca temporal UTC de la verificación en formato ISO 8601",
            "example": "2026-11-10T22:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "database",
          "timestamp"
        ]
      },
      "DatabaseHealthDownDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Estado de conectividad o preparación de PostgreSQL cuando falla la sonda",
            "example": "down",
            "enum": [
              "down"
            ]
          },
          "schema": {
            "type": "string",
            "description": "Esquema configurado en PostgreSQL",
            "example": "sigeh"
          },
          "schemaVerified": {
            "type": "boolean",
            "description": "Indica si el esquema pudo ser verificado antes del fallo",
            "example": false
          }
        },
        "required": [
          "status",
          "schema",
          "schemaVerified"
        ]
      },
      "HealthErrorResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Estado general cuando hay degradación crítica o falta de preparación",
            "example": "error",
            "enum": [
              "error"
            ]
          },
          "service": {
            "type": "string",
            "description": "Identificador lógico del servicio API",
            "example": "sige-h-api"
          },
          "database": {
            "description": "Diagnóstico sanitizado de la base de datos",
            "allOf": [
              {
                "$ref": "#/components/schemas/DatabaseHealthDownDto"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensaje público sanitizado sin exponer credenciales ni trazas internas",
            "example": "Base de datos PostgreSQL no disponible"
          },
          "timestamp": {
            "type": "string",
            "description": "Marca temporal UTC del fallo en formato ISO 8601",
            "example": "2026-11-10T22:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "database",
          "message",
          "timestamp"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identificador": {
            "type": "string",
            "maxLength": 100,
            "example": "cuenta_ficticia"
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 1024
          }
        },
        "required": [
          "identificador",
          "password"
        ]
      },
      "TokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "number",
            "example": 300
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "sessionId"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "writeOnly": true,
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string",
            "enum": [
              "local"
            ]
          },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "nullable": true,
                  "enum": [
                    "TITULAR",
                    "ENCARGADO"
                  ]
                },
                "scope": {
                  "type": "object",
                  "properties": {
                    "hospitalId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "divisionId": {
                      "type": "string",
                      "format": "uuid",
                      "nullable": true
                    },
                    "servicioId": {
                      "type": "string",
                      "format": "uuid",
                      "nullable": true
                    }
                  }
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": [
          "usuarioId",
          "sessionId",
          "provider",
          "assignments"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
