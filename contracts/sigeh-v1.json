    "/api/v1/health/live": {
      "get": {
        "description": "Verifica que el proceso de la API NestJS está activo y respondiendo peticiones HTTP sin depender de PostgreSQL.",
        "operationId": "getHealthLive",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Proceso API activo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponseDto"
                }
              }
            }
          }
        },
        "summary": "Health básico de liveness de la API (CU-OPS-01)",
        "tags": [
          "Health"
        ],
        "x-sigeh-status": "local-tested"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Verifica conectividad con el pool de PostgreSQL (SELECT 1) y la existencia del esquema configurado antes de recibir tráfico operativo.",
        "operationId": "getHealthReady",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API y esquema PostgreSQL listos para operar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL inaccesible o esquema sigeh no disponible (respuesta sanitizada)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Readiness de PostgreSQL y esquema sigeh (CU-OPS-02)",
        "tags": [
          "Health"
        ],
        "x-sigeh-status": "local-tested"
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Ejecuta la verificación de readiness contra el pool de PostgreSQL en el esquema configurado y retorna el estado operativo sin exponer credenciales.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API y base de datos PostgreSQL operativas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Fallo de conectividad o indisponibilidad de PostgreSQL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Verificar salud de la API y conexión a PostgreSQL (compatibilidad Sprint 0 / CU-OPS-02)",
        "tags": [
          "Health"
        ],
        "x-sigeh-status": "local-tested"
      }
    },
